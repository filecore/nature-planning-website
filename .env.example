# Public hostname Traefik routes to this container (no scheme).
NATURE_DOMAIN=nature.example.cc

# Deploy target (used by deploy.sh only). Replace with your own.
REMOTE_HOST=user@host
REMOTE_DIR=/home/user/docker/nature

# Optional: Maanmittauslaitos WMTS API key. Get one for free at
# https://www.maanmittauslaitos.fi/asiointipalvelut. If left empty the
# frontend falls back to OpenStreetMap as the primary basemap.
MML_API_KEY=
